# Copy to malica.env (next to docker-compose.yml). Never commit the copy.

# Caddy obtains a Let's Encrypt certificate for this name ("localhost" for local runs = self-signed).
MALICA_DOMAIN=malica.example.com
MALICA_TLS_EMAIL=you@example.com

# PIN of the first group (created on first start); admin PIN (empty = admin panel disabled).
MALICA_PIN=1234
MALICA_ADMIN_PIN=change-me
MALICA_EXT_URL=https://chromewebstore.google.com/detail/<extension-id>
MALICA_DEFAULT_LOCATION=46.0511,14.5051,Ljubljana
